<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- #region MJobs_Caring -->

  <Operation Class="ManyJobs.PatchOps.IfWorkTypeIsEnabled">
    <workType>MJobs_Caring</workType>
    <operations>

      <li Class="PatchOperationReplace">
        <xpath>Defs/WorkGiverDef[defName = "DBHAdministerFluids"]/workType</xpath>
        <value>
          <workType>MJobs_Caring</workType>
        </value>
      </li>

      <li Class="PatchOperationReplace">
        <xpath>Defs/WorkGiverDef[defName = "DBHAdministerFluidsWarden"]/workType</xpath>
        <value>
          <workType>MJobs_Caring</workType>
        </value>
      </li>

      <li Class="PatchOperationReplace">
        <xpath>Defs/WorkGiverDef[defName = "washPatient"]/workType</xpath>
        <value>
          <workType>MJobs_Caring</workType>
        </value>
      </li>

      <li Class="PatchOperationReplace">
        <xpath>Defs/WorkGiverDef[defName = "DocCleanBedpan"]/workType</xpath>
        <value>
          <workType>MJobs_Caring</workType>
        </value>
      </li>

    </operations>
  </Operation>

  <!-- #endregion -->

  <!-- #region MJobs_PriorityHauling -->

  <Operation Class="ManyJobs.PatchOps.IfWorkTypeIsEnabled">
    <workType>MJobs_PriorityHauling</workType>
    <operations>

      <li Class="PatchOperationReplace">
        <xpath>Defs/WorkGiverDef[defName = "UnloadWashing"]/workType</xpath>
        <value>
          <workType>MJobs_PriorityHauling</workType>
        </value>
      </li>

      <li Class="PatchOperationReplace">
        <xpath>Defs/WorkGiverDef[defName = "LoadWashing"]/workType</xpath>
        <value>
          <workType>MJobs_PriorityHauling</workType>
        </value>
      </li>

      <li Class="PatchOperationReplace">
        <xpath>Defs/WorkGiverDef[defName = "UnloadComposter"]/workType</xpath>
        <value>
          <workType>MJobs_PriorityHauling</workType>
        </value>
      </li>

      <li Class="PatchOperationReplace">
        <xpath>Defs/WorkGiverDef[defName = "FillComposter"]/workType</xpath>
        <value>
          <workType>MJobs_PriorityHauling</workType>
        </value>
      </li>

      <li Class="PatchOperationReplace">
        <xpath>Defs/WorkGiverDef[defName = "emptySepticTank"]/workType</xpath>
        <value>
          <workType>MJobs_PriorityHauling</workType>
        </value>
      </li>

      <li Class="PatchOperationReplace">
        <xpath>Defs/WorkGiverDef[defName = "RefillWater"]/workType</xpath>
        <value>
          <workType>MJobs_PriorityHauling</workType>
        </value>
      </li>

    </operations>
  </Operation>

  <!-- #endregion -->

  <!-- #region MJobs_Undertaking -->

  <Operation Class="ManyJobs.PatchOps.IfWorkTypeIsEnabled">
    <workType>MJobs_Undertaking</workType>
    <operations>

      <!-- Make a copy of DoBillsBurnPit and rename it to DoBillsBurnPitUndertake.
           This is because some bills are not undertaking (e.g. burn apparel). -->
      <li Class="ManyJobs.PatchOps.PatchOperationDuplicate">
        <xpath>Defs/WorkGiverDef[defName = "DoBillsBurnPit"]</xpath>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/WorkGiverDef[defName = "DoBillsBurnPit"][2]/defName</xpath>
        <value>
            <defName>DoBillsBurnPitUndertake</defName>
        </value>
      </li>

      <li Class="PatchOperationReplace">
        <xpath>Defs/WorkGiverDef[defName = "DoBillsBurnPitUndertake"]/workType</xpath>
        <value>
          <workType>MJobs_Undertaking</workType>
        </value>
      </li>

      <li Class="PatchOperationAdd">
        <xpath>Defs/RecipeDef[defName = "CremateCorpse"]</xpath>
        <value>
          <requiredGiverWorkType>MJobs_Undertaking</requiredGiverWorkType>
        </value>
      </li>

      <!-- Change label of the work (for prioritizing work) so that the two works are different. -->
      <li Class="PatchOperationReplace">
        <xpath>Defs/WorkGiverDef[defName = "DoBillsBurnPitUndertake"]/verb</xpath>
        <value>
          <verb>cremate at</verb>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/WorkGiverDef[defName = "DoBillsBurnPitUndertake"]/gerund</xpath>
        <value>
          <gerund>cremating at</gerund>
        </value>
      </li>

    </operations>
  </Operation>

  <!-- #endregion -->

  <!-- #region MJobs_Maintaining -->

  <Operation Class="ManyJobs.PatchOps.IfWorkTypeIsEnabled">
    <workType>MJobs_Maintaining</workType>
    <operations>

      <li Class="PatchOperationReplace">
        <xpath>Defs/WorkGiverDef[defName = "ClearBlockage"]/workType</xpath>
        <value>
          <workType>MJobs_Maintaining</workType>
        </value>
      </li>

    </operations>
  </Operation>

  <!-- #endregion -->

</Patch>
